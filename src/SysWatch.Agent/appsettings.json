{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Agent": {
    "DataDir": "C:\\ProgramData\\SysWatch\\hot",
    "SampleIntervalSeconds": 5,
